# Proxmox Backup Orchestrator production environment example.
# Copy to .env on the app VM and fill in real values. Never commit .env.
# Generate random tokens/secrets with: openssl rand -hex 32
# Do not use code_secret.
#
# Docker Compose .env warning:
# bcrypt hashes contain "$". In Compose env files every "$" must be escaped as "$$".
# Example: AUTH_PASSWORD_HASH=$$2b$$12$$...

# -----------------------------------------------------------------------------
# App VM only: Docker Compose, API, Web UI, Postgres
# -----------------------------------------------------------------------------
APP_ENV=production
API_PORT=8000
WEB_PORT=5173
WEB_ALLOWED_HOSTS=extbackup.sofianechaoui.fr,localhost,127.0.0.1,192.168.1.103
FRONTEND_ORIGIN=http://backup-orchestrator.example.local:5173
FRONTEND_ORIGIN_ALT=http://backup-orchestrator.example.local
AUTO_SYNC_ENABLED=true
PROXMOX_SYNC_INTERVAL_SECONDS=60
PBS_SYNC_INTERVAL_SECONDS=60
MAINTENANCE_TIMEOUT_SECONDS=300
APP_MAINTENANCE_AGENT_BASE_URL=http://host.docker.internal:8092
APP_MAINTENANCE_AGENT_HOST=127.0.0.1
APP_MAINTENANCE_AGENT_PORT=8092
APP_MAINTENANCE_AGENT_TOKEN=replace-with-random-app-maintenance-token
APP_REPO_PATH=/opt/proxmox_backup_orchestrator
APP_COMPOSE_FILE=infra/docker/docker-compose.yml
APP_MAINTENANCE_TIMEOUT_SECONDS=300
APP_MAINTENANCE_AGENT_SERVICE=proxmox-backup-orchestrator-app-maintenance-agent.service

POSTGRES_DB=proxmox_backup_orchestrator
POSTGRES_USER=pbo
POSTGRES_PASSWORD=replace-with-random-postgres-password
DATABASE_URL=postgresql+psycopg://pbo:replace-with-random-postgres-password@db:5432/proxmox_backup_orchestrator

AUTH_ENABLED=true
AUTH_USERNAME=admin
# Generate with: py scripts/generate_password_hash.py
# bcrypt passwords are limited to 72 bytes after UTF-8 encoding.
AUTH_PASSWORD_HASH=$$2b$$12$$replace-with-generated-bcrypt-hash
# Generate with: openssl rand -hex 32
AUTH_SECRET_KEY=replace-with-random-jwt-secret
AUTH_TOKEN_EXPIRE_MINUTES=180

NOTIFICATIONS_ENABLED=true
NTFY_BASE_URL=https://ntfy.YOURDOMAINE.com
NTFY_TOPIC=replace-with-secret-topic
NTFY_USERNAME=pbo
NTFY_PASSWORD=replace-with-ntfy-password
NOTIFY_ON_BACKUP_SUCCESS=true
NOTIFY_ON_BACKUP_FAILURE=true
NOTIFY_ON_DISK_EJECT_READY=true
NOTIFY_ON_UPDATE_RESULT=true
NOTIFY_ON_AGENT_DEGRADED=true
NOTIFY_ON_LOW_COVERAGE=true
NOTIFY_ON_DISK_NEW_DETECTED=true
NOTIFY_ON_DISK_KNOWN_DETECTED=true
NOTIFY_ON_PLANNED_DISK_DETECTED=true
NOTIFY_ON_PLANNED_BACKUP_REMINDER=true
NOTIFY_ON_PLANNED_BACKUP_STARTED=true
NOTIFY_ON_PLANNED_CONFIRMATION_REQUIRED=true
NOTIFY_ON_PLANNED_BACKUP_MISSED=true
LOW_COVERAGE_THRESHOLD_PERCENT=100
PLANNING_SCHEDULER_ENABLED=true
PLANNING_SCHEDULER_INTERVAL_SECONDS=60
DISK_DETECTION_NOTIFY_COOLDOWN_SECONDS=1800

PVE_API_URL=https://proxmox.example.local:8006/api2/json
PVE_API_TOKEN_ID=root@pam!pbo-api
PVE_API_TOKEN_SECRET=replace-with-proxmox-api-token-secret
PVE_VERIFY_SSL=false
PVE_NODE_NAME=proxmox

PBS_API_URL=https://pbs.example.local:8007/api2/json
PBS_TOKEN_ID=root@pam!pbo-pbs
PBS_TOKEN_SECRET=replace-with-pbs-api-token-secret
PBS_VERIFY_SSL=false
PBS_FINGERPRINT=
# Main/source PBS datastore.
PBS_DATASTORE=backup-store

# PBS VM as seen by Proxmox for USB passthrough.
PBS_EXECUTION_VM_ID=100
PBS_EXECUTION_VM_NODE=proxmox

# App VM -> Proxmox host root agent.
HOST_AGENT_BASE_URL=http://proxmox.example.local:8090
HOST_AGENT_TOKEN=replace-with-same-token-as-proxmox-agent-AGENT_SERVER_TOKEN
HOST_AGENT_TIMEOUT_SECONDS=7200

# App VM -> PBS VM root agent.
PBS_AGENT_BASE_URL=http://pbs.example.local:8091
PBS_AGENT_TOKEN=replace-with-same-token-as-pbs-agent-AGENT_SERVER_TOKEN
PBS_AGENT_TIMEOUT_SECONDS=7200

EXTERNAL_BACKUP_CALLBACK_BASE_URL=http://api:8000/api/v1
EXTERNAL_BACKUP_LEGACY_COEXISTENCE_ENABLED=false
AGENT_STALE_AFTER_MINUTES=10
SHOW_SEED_DISKS=false

# -----------------------------------------------------------------------------
# Proxmox host agent only: /opt/proxmox-backup-orchestrator-agent/.env
# Copy this block to the Proxmox host agent .env and uncomment it there.
# -----------------------------------------------------------------------------
# AGENT_API_BASE_URL=http://backup-orchestrator.example.local:8000/api/v1
# AGENT_HOSTNAME=proxmox
# AGENT_VERSION=0.1.0
# AGENT_TIMEOUT_SECONDS=10
# AGENT_INCLUDE_NON_USB_CANDIDATES=false
# AGENT_EXPORT_TIMEOUT_SECONDS=7200
# AGENT_DATASTORE_CREATE_TIMEOUT_SECONDS=14400
# AGENT_SERVER_HOST=0.0.0.0
# AGENT_SERVER_PORT=8090
# AGENT_SERVER_TOKEN=replace-with-random-host-agent-token
# AGENT_REPO_PATH=/opt/proxmox-backup-orchestrator-agent
# AGENT_MAINTENANCE_TIMEOUT_SECONDS=120

# -----------------------------------------------------------------------------
# PBS VM agent only: /opt/proxmox-backup-orchestrator-pbs-agent/.env
# Copy this block to the PBS agent .env and uncomment it there.
# -----------------------------------------------------------------------------
# AGENT_API_BASE_URL=http://backup-orchestrator.example.local:8000/api/v1
# AGENT_HOSTNAME=pbs
# AGENT_VERSION=0.1.0
# AGENT_TIMEOUT_SECONDS=10
# AGENT_INCLUDE_NON_USB_CANDIDATES=false
# AGENT_EXPORT_TIMEOUT_SECONDS=7200
# AGENT_DATASTORE_CREATE_TIMEOUT_SECONDS=14400
# AGENT_SERVER_HOST=0.0.0.0
# AGENT_SERVER_PORT=8091
# AGENT_SERVER_TOKEN=replace-with-random-pbs-agent-token
# AGENT_REPO_PATH=/opt/proxmox-backup-orchestrator-pbs-agent
# AGENT_MAINTENANCE_TIMEOUT_SECONDS=120
